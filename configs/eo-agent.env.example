# eo-agent config (OpenAI-compatible). Copy to ~/.config/eo-agent/config.env
# and run: chmod 600 ~/.config/eo-agent/config.env
#
# Precedence: environment variables > this file.

# Base URL of an OpenAI-compatible endpoint (no trailing /chat/completions).
EO_LLM_BASE_URL=https://api.openai.com/v1

# API key. Leave empty for local endpoints (e.g. Ollama) that need no auth.
EO_LLM_API_KEY=

# Model name.
EO_LLM_MODEL=gpt-4o-mini
